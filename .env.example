# Public browser API base. Leave blank for local Vite proxying to port 8000.
VITE_BOOKING_API_BASE_URL=

# Optional exact origins for the Replit booking API, comma-separated.
# Vercel preview/production origins are allowed by the API by default.
BOOKING_ALLOWED_ORIGINS=

# Existing optional scheduled-job secrets.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
